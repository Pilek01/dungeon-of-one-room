+test("Vault Guardian telegraphs expose Hoard Sentence countdown and deduplicated Lockdown crosses", () => {
+  const commands = vfx.collectTelegraphCommands({
+    phase: "playing",
+    roomType: "vault",
+    nowMs: 600,
+    player: { x: 4, y: 4 },
+    chests: [{ x: 2, y: 2, opened: false, vaultCondemned: true, vaultCondemnTurns: 3 }],
+    enemies: [{
+      type: "guardian",
+      x: 4,
+      y: 1,
+      vaultLockdownAiming: true,
+      vaultLockdownTargets: [{ x: 4, y: 4 }, { x: 5, y: 4 }]
+    }]
+  }, { quality: "high" });
+
+  const sentence = commands.find((command) => command.kind === "vault-sentence-mark");
+  assert.ok(sentence);
+  assert.equal(sentence.turns, 3);
+  assert.deepEqual([sentence.x, sentence.y], [2, 2]);
+
+  const anchors = commands.filter((command) => command.kind === "vault-lockdown-anchor");
+  assert.equal(anchors.length, 2);
+  const areas = commands.filter((command) => command.kind === "vault-lockdown-area");
+  const areaKeys = areas.map((command) => `${command.x},${command.y}`);
+  assert.equal(new Set(areaKeys).size, areaKeys.length);
+  assert.ok(areaKeys.includes("4,4"));
+  assert.ok(areaKeys.includes("3,4"));
+  assert.ok(areaKeys.includes("6,4"));
+  assert.ok(areaKeys.includes("4,3"));
+  assert.ok(areaKeys.includes("5,5"));
+});
